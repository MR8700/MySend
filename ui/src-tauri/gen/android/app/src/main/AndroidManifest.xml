<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice notes & P2P Real-Time Calls: WebView getUserMedia needs audio grants -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- QR camera scanner: WebView getUserMedia({video:true}) needs this Android-level grant too
         — without it, the WebView's permission bridge denies the request outright before Android
         ever shows the "Allow NOVA Chat to use the camera?" runtime prompt, which is exactly what
         made the scanner fail with a permission error the app never visibly asked for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Location sharing: WebView navigator.geolocation needs at least one of these. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background P2P socket survival: Foreground service and wake lock -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Same-Wi-Fi peer discovery (mDNS, see nova-transport's dht_node.rs) is entirely multicast
         — Android drops incoming multicast packets by default to save power, so this is required
         for MainActivity's MulticastLock to actually let mDNS replies through. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.nova_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the Rust P2P engine (mDNS/DHT listener, outbox retry pump) alive while the app
             is backgrounded — see P2pForegroundService's doc comment. android:foregroundServiceType
             must match the FOREGROUND_SERVICE_DATA_SYNC permission declared above and the type
             passed to startForeground() in the service itself. -->
        <service
          android:name=".P2pForegroundService"
          android:exported="false"
          android:foregroundServiceType="dataSync" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
